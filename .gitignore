# ============================================================
# 数治骑迹平台 .gitignore
# 原则：只提交源码 + 配置 + 小体积样例数据，
#       所有"可再生的东西"（依赖、编译产物、运行时输出）一律忽略
# ============================================================

# ---------- Python 字节码 / 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# ---------- 虚拟环境（约 1.1GB，pip install -r requirements.txt 可重建）----------
venv/
.venv/
env/
ENV/

# ---------- 内嵌依赖库 .vendor（137MB，PyInstaller 打包用的第三方库副本，可重建）----------
.vendor/

# ---------- PyInstaller 打包产物（build 523MB + dist 974MB）----------
build/
dist/
*.manifest

# ---------- 便携版发布包（974MB，exe 及百度网盘未下完的临时文件）----------
数治骑迹-便携版/
*.baiduyun.p.downloading

# ---------- 运行时生成物（分析结果、图表、报告、日志，均可由 API 重新生成）----------
outputs/
backend/uploads/
outputs/runtime/
/uploads/

# ---------- 日志 ----------
*.log
logs/

# ---------- 用户上传 / 环境变量 / 密钥 ----------
.env
.env.*
*.pem
*.key
# 含真实 LLM 密钥的本地启动脚本，禁止提交
start_v2.bat
# 本机走局域网代理的开关文件（每台机器自己决定）
use_proxy.flag

# ---------- IDE / 编辑器 / 系统 ----------
.vs/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 前端（Vue 原型，提交源码不提交构建物）----------
frontend/node_modules/
frontend/dist/
frontend/.cache/

# ---------- 说明文档中的大体积二进制 ----------
# 说明文档共 155MB，其中 152MB 是 展示0.docx；保留 md/txt 文本，忽略 docx/pptx/pdf/xlsx
说明文档/**/*.docx
说明文档/**/*.pptx
说明文档/**/*.pdf
说明文档/**/*.xlsx

# ============================================================
# 可选项：数据文件目前体积很小（data.csv 0.1MB），默认提交，
# 保证克隆后开箱能跑。若数据涉及隐私/敏感信息，取消下面注释：
# ============================================================
# /data.csv
# /test_data.csv
# /backend/uploads/data.csv
